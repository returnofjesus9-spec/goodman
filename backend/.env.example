# Neon connection string (postgresql://user:password@host/dbname?sslmode=require)
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
JWT_SECRET=change-me-to-a-long-random-secret
# Comma-separated list of allowed frontend origins, e.g. https://goodman.example.workers.dev
ALLOWED_ORIGINS=https://your-frontend.pages.dev
